# Firebase web app config (client-side, not secret — scoped by Firestore rules and
# authorized domains). Leave unset to use the built-in default project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# AI assistant proxy — the deployed URL of the `assistant` Cloud Function.
# Used by the front-end widget (added in a later task). Leave unset in local
# dev to fall back to the same-origin "/api/assistant" path.
# Example: https://us-central1-personal-wealth-os-1deac.cloudfunctions.net/assistant
VITE_ASSISTANT_ENDPOINT=

# The OpenRouter API key is NOT set here — it is a server-side secret held by
# the Cloud Function via `firebase functions:secrets:set OPENROUTER_API_KEY`.
