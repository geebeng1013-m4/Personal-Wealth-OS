git# Created automatically when a Vercel Blob store is connected to the project.
# The server uses this token for both private text and explicitly public file uploads.
BLOB_READ_WRITE_TOKEN=

# Firebase service account JSON, stored as one line. Never expose it with a VITE_ prefix.
# Local development may instead use Application Default Credentials.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Firebase web app config (client-side, not secret — scoped by Firestore rules and
# authorized domains). Leave unset to use the built-in default project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=