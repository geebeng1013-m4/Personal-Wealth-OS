rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only read/write their own data
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // The assistant's daily counters. Denied to every client on purpose: a
    // counter its owner can reset is not a limit. Only the assistant Cloud
    // Function writes here, with admin credentials, which these rules do not
    // apply to.
    match /assistantUsage/{document} {
      allow read, write: if false;
    }
  }
}
